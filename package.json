{
  "name": "sup-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build:web": "react-router build",
    "build:native": "cross-env BUILD_TARGET=native react-router build",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "security": "semgrep scan --error --metrics=off --config=p/typescript --config=p/react --config=p/secrets --config=p/owasp-top-ten --config=p/sql-injection --exclude=node_modules --exclude=build --exclude=.react-router && npm run typecheck && npm audit --omit=dev",
    "test": "vitest run --passWithNoTests",
    "sb": "bash scripts/sb.sh",
    "sources:check": "cross-env NODE_EXTRA_CA_CERTS=tools/source-check/intermediates.pem node tools/source-check/cli.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "e2e": "playwright test --project=chromium --project=mobile",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:perf": "npm run build:web && cross-env PERF_RUN=1 playwright test --project=perf --workers=1",
    "e2e:visual": "playwright test --project=visual",
    "e2e:visual:update": "playwright test --project=visual --update-snapshots"
  },
  "dependencies": {
    "@react-router/node": "^7.18.2",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "i18next": "^26.3.6",
    "isbot": "^5.1.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.10",
    "react-router": "^7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@netlify/vite-plugin-react-router": "^3.1.1",
    "@playwright/test": "^1.62.0",
    "@react-router/dev": "^7.18.2",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.27.0",
    "eslint-import-resolver-typescript": "^4.3.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.32.0",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
