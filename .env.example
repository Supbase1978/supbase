# SUP Platform — környezeti változók MINTÁJA (F1.1, 4. fejezet).
# Másold `.env`-be és töltsd ki. TITKOT IDE NE ÍRJ, és a valódi .env-et
# soha ne kommiteld. A VITE_ prefixű értékek PUBLIKUSAK (a kliens-bundle-be
# is bekerülnek) — csak olyasmi kaphat VITE_ prefixet, ami eleve nyilvános.

# Supabase projekt-URL (publikus). Supabase → Project Settings → Data API.
VITE_SUPABASE_URL=

# Supabase PUBLISHABLE API-kulcs (sb_publishable_..., publikus — RLS mögött
# érvényesül). Supabase → Project Settings → API Keys → Publishable key.
# A legacy `anon` JWT-kulcs helyett EZT használjuk (a Supabase is ezt ajánlja).
# FIGYELEM: a SECRET kulcs (sb_secret_..., a legacy `service_role` utódja)
# TITOK — ide SOHA nem kerülhet; ha privilegizált hozzáférés kell (Edge
# Function), azt a Supabase Edge Function secrets-ben tároljuk.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase FIÓK access token (sbp_..., TITOK) — a Supabase CLI-hez, a
# scripts/sb.sh wrapper olvassa be (supabase link, db push stb. a
# Supbase1978-identitással, globális `supabase login` nélkül).
# Létrehozás: https://supabase.com/dashboard/account/tokens
# FIGYELEM: SOHA ne kapjon VITE_ prefixet — az bekerülne a kliens-bundle-be!
SUPABASE_ACCESS_TOKEN=

# VAPID PUBLIKUS kulcs a Web Pushhoz (F1.9). Generálás:
#   node scripts/generate-vapid.mjs   → .vapid.json (gitignore-olt)
# A PÁRJA (VAPID_PRIVATE_KEY) TITOK: kizárólag a Supabase Edge Function
# secrets-be kerül (`npm run sb -- secrets set ...`), ide SOHA.
# Üresen hagyva a feliratkozó-gomb hibát jelez, a többi funkció változatlan.
VITE_VAPID_PUBLIC_KEY=

# Cloudflare Turnstile SITE key (publikus). Ha üresen hagyod, a captcha
# fejlesztői módban kikapcsol, a formok használhatók maradnak.
# A Turnstile SECRET kulcs NEM ide való: azt a Supabase Dashboardban
# (Auth → Attack Protection / CAPTCHA) kell beállítani — a secret-oldali
# verifikációt a Supabase Auth végzi a signUp/signIn hívások captcha-tokenjén.
VITE_TURNSTILE_SITE_KEY=

# --- Visszajelzés-csatorna e-mail-értesítése (F2.2) — OPCIONÁLIS ------------
# NEM VITE_ prefixes: szerver-oldali (SSR) env, a böngészőbe nem kerül ki.
# Ha bármelyik hiányzik, az értesítés CSENDBEN kimarad — a visszajelzés attól
# még az adatbázisban van, és a /admin/visszajelzesek felületen látszik.
# A Resend-bekötés az élesítési checklist része (docs/RUNBOOK.md).
RESEND_API_KEY=
FEEDBACK_TO_EMAIL=
FEEDBACK_FROM_EMAIL=
